{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Manager",
  "mainBinaryName": "claude-manager",
  "identifier": "tech.local.claudemanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Manager",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 520,
        "theme": "Dark",
        "backgroundColor": "#0f1115",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Organiseur de projets et conversations Claude Code",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBMEEyMzEyQkU5QThFNEYKUldSUGpwcStFaU1LcXNsYWNnTjhUL2Z0YzE4NjVBekJDUUFvSWJmOW1wcHRXRjkrYjhnRlp4cWMK",
      "endpoints": [
        "https://github.com/SixtyOne61/ClaudeManager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
